FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml* package-lock.json* ./

RUN corepack enable && pnpm install 2>/dev/null || npm install

COPY tsconfig.json ./
COPY src ./src

EXPOSE 5003

CMD ["npx", "ts-node-dev", "--respawn", "--poll", "--transpile-only", "-r", "tsconfig-paths/register", "src/server.ts"]
